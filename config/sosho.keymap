//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

// Higher layer numbers take priority over lower active layers.
#define BASE 0
#define NUM 1
#define NAV 2
#define NUM_OVER_NAV 3
#define FN 4
#define ALT 5
#define CONNECT 6

// Raw HID positions for Windows JIS, not the US legends in keys.h.
#define JP_AT LBKT
#define JP_COLON SQT
#define JP_CARET EQUAL
#define JP_LBKT RBKT
#define JP_RBKT NUHS
#define JP_YEN INT_YEN
#define JP_BSLH INT_RO
#define JP_ZKHK GRAVE

/ {
	behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
            keep-mods = <0>;
        };

        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
    // A tap followed by a hold can activate Ctrl, rather than repeat Tab.
    quick-tap-ms = <0>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
    // Space/Enter can activate their layers even immediately after a tap.
    quick-tap-ms = <0>;
};

&sk {
    quick-release;
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
            layers = <BASE>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
            layers = <BASE>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
            layers = <BASE>;
        };

        combo_BACK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp MB4>;
            layers = <NUM NUM_OVER_NAV>;
        };

        combo_FORWARD {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp MB5>;
            layers = <NUM NUM_OVER_NAV>;
        };

        combo_SHIFT {
            timeout-ms = <50>;
            key-positions = <15 20>;
            bindings = <&sk LSHFT>;
            layers = <BASE>;
        };

        combo_CTRL {
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
            key-positions = <16 19>;
            bindings = <&sk LCTRL>;
            layers = <BASE>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp F11         &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y     &kp U     &kp I      &kp O    &kp P          &kp F12
            &kp LANG1       &kp A  &kp S  &kp D  &kp F  &kp G     &kp H     &kp J     &kp K      &kp L    &mt LCTRL TAB  &lt FN LANG2
            &kp LGUI        &mt LSHFT Z &kp X &kp C &kp V &kp B  &kp N     &kp M     &kp COMMA  &kp DOT  &kp SLASH      &kp LALT
            &kp LALT        &kp JP_ZKHK &lt NUM SPACE &lt ALT ESC &bspc_del &lt NAV ENTER                  &kp LC(LA(DEL)) &mo CONNECT
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &trans  &kp LS(N1)  &kp JP_AT  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)   &kp LS(JP_YEN)  &kp LS(N6)  &kp LS(JP_COLON)  &kp LS(JP_AT)  &kp LS(JP_CARET)  &trans
            &trans  &kp N1      &kp N2     &kp N3      &kp N4      &kp N5       &kp KP_PLUS     &kp LS(MINUS) &kp MINUS        &kp JP_CARET   &trans           &trans
            &trans  &kp N6      &kp N7     &kp N8      &kp N9      &kp N0       &kp JP_BSLH     &kp LS(JP_BSLH) &trans          &trans         &trans           &trans
            &trans  &trans                              &trans     &trans      &kp DEL         &trans                                         &trans           &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans  &kp LS(N1)   &kp JP_AT        &kp LS(N3)  &kp LS(N4)  &kp LS(N5)   &kp LS(JP_YEN)  &kp LS(N6)  &kp LS(JP_COLON)  &kp LS(JP_AT)  &kp LS(JP_CARET)  &trans
            &trans  &kp JP_COLON &kp LS(JP_LBKT)  &kp JP_LBKT &kp LS(N8)  &kp LS(N2)   &kp LEFT        &kp DOWN    &kp UP            &kp RIGHT      &trans           &trans
            &trans  &kp SEMI     &kp LS(JP_RBKT)  &kp JP_RBKT &kp LS(N7)  &kp LS(N9)   &kp HOME        &kp END     &kp LS(COMMA)     &kp LS(DOT)    &trans           &trans
            &trans  &trans                                  &lt NUM_OVER_NAV SPACE &kp ESC &trans     &trans                                          &trans           &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    // Resolve NUM's transparent keys to BASE explicitly so NAV cannot leak
    // through (e.g. '<'/'>' instead of ','/'.'). Momentary activation via &lt
    // leaves NAV active underneath, restoring it when Space is released.
    number_over_nav {
        bindings = <
            &kp F11   &kp LS(N1) &kp JP_AT &kp LS(N3) &kp LS(N4) &kp LS(N5)   &kp LS(JP_YEN) &kp LS(N6) &kp LS(JP_COLON) &kp LS(JP_AT) &kp LS(JP_CARET) &kp F12
            &kp LANG1 &kp N1     &kp N2    &kp N3     &kp N4     &kp N5       &kp KP_PLUS    &kp LS(MINUS) &kp MINUS      &kp JP_CARET  &mt LCTRL TAB   &lt FN LANG2
            &kp LGUI  &kp N6     &kp N7    &kp N8     &kp N9     &kp N0       &kp JP_BSLH    &kp LS(JP_BSLH) &kp COMMA     &kp DOT       &kp SLASH       &kp LALT
            &kp LALT  &kp JP_ZKHK                   &lt NUM SPACE &lt ALT ESC &kp DEL        &lt NAV ENTER                                 &kp LC(LA(DEL)) &mo CONNECT
        >;
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

    layer_4 {
        bindings = <
            &kp F11 &kp F1  &kp F2  &kp F3  &kp F4  &kp F5   &kp F6    &kp F7    &kp F8  &kp F9  &kp F10  &kp F12
            &trans  &trans  &trans  &trans  &trans  &trans   &trans    &trans    &trans  &trans  &trans   &trans
            &trans  &trans  &trans  &trans  &trans  &trans   &trans    &trans    &trans  &trans  &trans   &trans
            &trans  &trans                 &trans  &trans   &trans    &trans                    &trans   &trans
        >;
    };

    layer_5 {
        bindings = <
            &trans  &kp LA(Q) &kp LA(W)  &kp LA(E)  &kp LA(R)  &kp LA(T)   &kp LA(Y)  &kp LA(U)  &kp LA(I)  &kp LA(O)  &kp LA(P) &trans
            &trans  &kp LA(A) &kp LA(S)  &kp LA(D)  &kp LA(F)  &kp LA(G)   &kp LA(H)  &kp LA(J)  &kp LA(K)  &kp LA(L)  &trans   &trans
            &trans  &kp LS(Z) &kp LA(X)  &kp LA(C)  &kp LA(V)  &kp LA(B)   &kp LA(N)  &kp LA(M)  &kp COMMA  &kp DOT    &trans   &trans
            &trans  &trans                                   &trans     &trans      &trans     &kp LA(ENTER)                       &trans   &trans
        >;
    };

    connection_layer {
        bindings = <
            &trans &trans &trans &trans &trans &trans   &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &bt BT_SEL 4
            &trans &trans &trans &trans &trans &trans   &trans &trans       &trans       &trans       &trans         &trans
            &trans &trans &trans &trans &trans &trans   &trans &trans       &trans       &trans       &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans   &trans &out OUT_BLE                           &trans         &trans
        >;
    };

};
};
